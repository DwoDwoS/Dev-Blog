---
import { getCollection, render } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';

export async function getStaticPaths() {
    const ressources = await getCollection('ressources');

    return ressources.map((ressource) => ({
        params: { slug: ressource.id },
        props: { ressource },
    }));
}

const { ressource } = Astro.props;
const { Content } = await render(ressource);
---

<html lang="fr">
    <head>
        <BaseHead title={ressource.data.title} description={ressource.data.description} />
    </head>
    <body>
        <Header />
        <main>
            <article>
                <p class="back-link"><a href="/ressources/">← Retour aux ressources</a></p>
                <header class="title">
                    <p class="type">{ressource.data.type}</p>
                    <h1>{ressource.data.title}</h1>
                    <p class="description">{ressource.data.description}</p>
                    <hr />
                </header>
                <div class="prose">
                    <Content />
                </div>
            </article>
        </main>
        <Footer />
    </body>
</html>

<style>
    .title {
        margin: 2em 0;
        text-align: center;
    }

    .title h1 {
        margin-bottom: 0.5em;
    }

    .type {
        color: rgb(var(--gray));
        font-size: 0.8em;
        text-transform: uppercase;
    }

    .description {
        color: rgb(var(--gray-dark));
    }

    .prose {
        color: rgb(var(--gray-dark));
    }
</style>